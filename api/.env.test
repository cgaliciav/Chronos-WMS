# Variables de la suite de integración (versionado; sin secretos reales). Las del entorno (CI) tienen prioridad.
# Nunca apuntes esto a una base real: `npm run test:int` borra y recrea el esquema.
NODE_ENV=test
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=almacen_test
DB_PASSWORD=almacen_test
DB_DATABASE_NAME=almacen_test
DB_SYNCRO=false
DB_LOGGING=error
JWTSECRET=solo-pruebas-0123456789abcdef0123456789abcdef
SALT_ROUNDS=4
API_ALMACEN=/api
LOG_CONSOLE_VERBOSE=error
DIAS_CUARENTENA=120
RUTA_ARCHIVOS=tmp/pruebas/archivos
RUTA_REPORTES=tmp/pruebas/reportes
UPLOADS=tmp/pruebas/uploads
ARCHIVOS_AUXILIARES=tmp/pruebas/auxiliares
IMAGENES_IMPORTACION=tmp/pruebas/importacion
TRUST_PROXY=loopback
LOGIN_MAX_INTENTOS=30
ARCHIVOS_PUBLICOS=false
SENTRY_DSN=
