# Copiar a .env y llenar. En el servidor: ~/teleset-almacen*/api-secrets.env
JWTSECRET=
SALT_ROUNDS=10
API_ALMACEN=/api
RUTA_ARCHIVOS=
RUTA_REPORTES=
UPLOADS=
ARCHIVOS_AUXILIARES=
# Días tras los que un préstamo o renta externa con saldo abierto se notifica como vencido (plan 02 · fase 7)
DIAS_CUARENTENA=120
# Días que se conservan en disco las copias de archivos (se regeneran desde la BD) y los reportes Excel
CACHE_ARCHIVOS_DIAS=30
REPORTES_DIAS=15
# Nivel del log (pino, JSON en stdout): LOG_NIVEL=trace|debug|info|warn|error|silent; si falta se deriva de LOG_CONSOLE_VERBOSE
LOG_CONSOLE_VERBOSE=error
LOG_NIVEL=info
IMAGENES_IMPORTACION=
PORT_ALMACEN_API=4100
DB_HOST=
DB_USER=
DB_PORT=3306
DB_PASSWORD=
DB_DATABASE_NAME=
# false: el esquema lo cambian las migraciones (npm run migration:run). Nunca true en producción.
DB_SYNCRO=false
DB_CACHE=true
DB_LOGGING=error
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=telesetalmacen@exogrid.xyz
# Proxy inverso de confianza para obtener la IP real del cliente (valores de Express: loopback, 1, "loopback, 172.18.0.0/16", true)
TRUST_PROXY=loopback
# Intentos de login por IP cada 15 minutos
LOGIN_MAX_INTENTOS=20
# TRANSICIÓN: `true` deja públicos los GET /file/* como antes. Por defecto (false) exigen token (cabecera `auth` o ?auth=).
ARCHIVOS_PUBLICOS=false
# Sentry (opcional): si SENTRY_DSN está vacío no se inicializa
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
