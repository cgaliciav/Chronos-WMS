{
  "name": "almacen-api",
  "version": "2.89.0-d",
  "description": "Proyecto de Almacen para Sony Mexico usando TypeORM, Express, Multer, Sharp...etc",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "autocannon": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sentry/node": "^11.12.0",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "tslib": "^2.9.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "tsc": "tsc",
    "dev": "ts-node-dev --respawn ./src/index.ts",
    "start": "ts-node ./src/index.ts",
    "prod": "node ./build/index.js",
    "migration:show": "ts-node src/migrar.ts show",
    "migration:run": "ts-node src/migrar.ts run",
    "migration:revert": "ts-node src/migrar.ts revert",
    "semilla:extraer": "ts-node src/semilla/extraerCatalogo.ts",
    "semilla:run": "ts-node src/sembrar.ts",
    "migration:generate": "ts-node src/test/generarMigracion.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.estricto.json",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "jest --selectProjects unit",
    "test:int": "ts-node src/test/resetDb.ts && jest --selectProjects integration --runInBand",
    "test:int:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:int:down": "docker compose -f docker-compose.test.yml down -v",
    "rendimiento": "ts-node src/test/resetDb.ts && ts-node src/test/rendimiento.ts",
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "migracion:prod": "node ./build/migrar.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/exo-almacen/alamcen-api.git"
  },
  "author": "Cesar Galicia",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/exo-almacen/alamcen-api/issues"
  },
  "homepage": "https://gitlab.com/exo-almacen/alamcen-api.git#readme",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
