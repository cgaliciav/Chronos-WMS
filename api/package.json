{
  "name": "almacen-api",
  "version": "2.63.67",
  "description": "Proyecto de Almacen para Sony Mexico usando TypeORM, Express, Multer, Sharp...etc",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/sharp": "^0.29.5",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^1.1.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sentry/node": "^11.11.0",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "exceljs": "^4.3.0",
    "express": "^4.17.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^5.0.2",
    "jsonwebtoken": "^8.5.1",
    "multer": "^1.4.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.7.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.1.13",
    "sharp": "^0.30.1",
    "tslib": "^2.9.1",
    "typeorm": "^0.2.41",
    "zod": "^4.6.7"
  },
  "scripts": {
    "tsc": "tsc",
    "dev": "ts-node-dev --respawn ./src/index.ts",
    "start": "ts-node ./src/index.ts",
    "prod": "node ./build/index.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:show": "ts-node ./node_modules/typeorm/cli.js migration:show",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert",
    "migration:generate": "ts-node src/test/generarMigracion.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.estricto.json",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "jest --selectProjects unit",
    "test:int": "ts-node src/test/resetDb.ts && jest --selectProjects integration --runInBand",
    "test:int:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:int:down": "docker compose -f docker-compose.test.yml down -v",
    "rendimiento": "ts-node src/test/resetDb.ts && ts-node src/test/rendimiento.ts",
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "migracion:prod": "node ./build/migrar.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/exo-almacen/alamcen-api.git"
  },
  "author": "Cesar Galicia",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/exo-almacen/alamcen-api/issues"
  },
  "homepage": "https://gitlab.com/exo-almacen/alamcen-api.git#readme",
  "overrides": {
    "typeorm": {
      "mysql2": "$mysql2"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
