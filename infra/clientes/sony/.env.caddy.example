# Cliente Sony con Caddy (reemplaza al nginx del host). Copiar a `.env` en el directorio remoto (chmod 600).
# Reutiliza los datos existentes: DATOS_DIR contiene db_data/mysql y exogrid/ como hoy. Secretos vacíos y comentados.

# --- Proyecto ---
COMPOSE_PROJECT_NAME=chronos-sony
CLIENTE=sony
# staging | produccion
ENTORNO=staging

# --- Imágenes (desplegar.sh sustituye la etiqueta de IMAGEN_WEB e IMAGEN_API) ---
IMAGEN_WEB=exogrid/chronos-web:0.0.0-s
IMAGEN_API=exogrid/chronos-api:0.0.0-s
MARIADB_IMAGEN=mariadb:10.3

# --- Datos (staging: /home/cesargv/teleset-almacen) ---
DATOS_DIR=/home/cesargv/teleset-almacen
DB_PUERTO_LOCAL=3308

# --- Base de datos (la existente de Sony) ---
DB_DATABASE_NAME=almacen_sony_migracion
DB_USER=almacen_usr
#DB_PASSWORD=
#DB_ROOT_PASSWORD=

# --- API ---
#JWTSECRET=
#CONFIG_CLAVE=
TRUST_PROXY=uniquelocal
# Transición: imágenes por <img src> sin token (procedimiento de migración, paso 3)
ARCHIVOS_PUBLICOS=true
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=2525
#SMTP_USER=
#SMTP_PASS=
SMTP_FROM=telesetalmacen@exogrid.xyz
SOPORTE_CORREO=soporte@exogrid.io
#SENTRY_DSN=
# Entorno de Sentry de la API. Vacío = igual que ENTORNO (en staging lo fija compose.staging.yml). Solo fíjalo si debe ser distinto.
#SENTRY_ENVIRONMENT=

# --- Web (Caddy) ---
DOMINIOS=
DNS_PROVEEDOR=linode
# Token REAL de Linode (permiso Domains: Read/Write); el módulo valida el formato al arrancar
#DNS_TOKEN=
ACME_EMAIL=
# Vacío o ausente = Let's Encrypt producción
#ACME_CA=
