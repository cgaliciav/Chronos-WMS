# Cliente AMZ. Copiar a `.env` en el directorio remoto del despliegue (chmod 600). Nunca se versiona el real.
# Los secretos van vacíos: se generan con `openssl rand -base64 32` (JWTSECRET, CONFIG_CLAVE) y `openssl rand -hex 16`.

# --- Proyecto ---
COMPOSE_PROJECT_NAME=chronos-amz
CLIENTE=amz
# staging | produccion
ENTORNO=staging

# --- Imágenes (desplegar.sh sustituye la etiqueta de IMAGEN_WEB e IMAGEN_API) ---
IMAGEN_WEB=exogrid/chronos-web:0.0.0-s
IMAGEN_API=exogrid/chronos-api:0.0.0-s
MARIADB_IMAGEN=mariadb:10.11

# --- Datos: aquí viven db_data/ y exogrid/ ---
DATOS_DIR=/srv/chronos-amz
# Puerto local de MariaDB (solo 127.0.0.1)
DB_PUERTO_LOCAL=3309

# --- Base de datos ---
DB_DATABASE_NAME=chronos_amz
DB_USER=chronos
#DB_PASSWORD=
#DB_ROOT_PASSWORD=

# --- API ---
#JWTSECRET=
#CONFIG_CLAVE=
TRUST_PROXY=uniquelocal
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=2525
#SMTP_USER=
#SMTP_PASS=
SMTP_FROM=chronos-amz@exogrid.xyz
SOPORTE_CORREO=soporte@exogrid.io
#SENTRY_DSN=
# Entorno de Sentry de la API. Vacío = igual que ENTORNO (en staging lo fija compose.staging.yml). Solo fíjalo si debe ser distinto.
#SENTRY_ENVIRONMENT=

# --- Web (Caddy) ---
# Dominios separados por coma; el primero se usa en la prueba de humo
DOMINIOS=
# cloudflare | linode
DNS_PROVEEDOR=cloudflare
# Token REAL del proveedor DNS (Cloudflare valida el formato al arrancar, incluso sin sitios TLS)
#DNS_TOKEN=
ACME_EMAIL=
# Vacío o ausente = Let's Encrypt producción. Para pruebas: https://acme-staging-v02.api.letsencrypt.org/directory
#ACME_CA=
